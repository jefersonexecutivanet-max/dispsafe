
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) name String email String @unique password String companyId String company Company @relation(fields: [companyId], references: [id]) createdAt DateTime @default(now()) auditLogs AuditLog[] }
model Company { id String @id @default(cuid()) name String cnpj String? phone String? email String? logo String? metaWabaId String? metaPhoneNumberId String? metaConnected Boolean @default(false) createdAt DateTime @default(now()) users User[] contacts Contact[] campaigns Campaign[] templates Template[] messages Message[] consentVersion String @default("v1.0") }
model Contact { id String @id @default(cuid()) companyId String company Company @relation(fields: [companyId], references: [id]) name String phone String normalizedPhone String optedIn Boolean @default(false) optedOut Boolean @default(false) categories String[] @default([]) origin String? consentDate DateTime? optOutDate DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt consents Consent[] optOuts OptOut[] messages Message[] campaignRecipients CampaignRecipient[] @@unique([companyId, normalizedPhone]) }
model Consent { id String @id @default(cuid()) contactId String contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade) phone String status String date DateTime @default(now()) origin String ip String? category String? textVersion String companyId String createdAt DateTime @default(now()) }
model OptOut { id String @id @default(cuid()) contactId String contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade) phone String date DateTime @default(now()) origin String message String? companyId String createdAt DateTime @default(now()) }
model Template { id String @id @default(cuid()) companyId String company Company @relation(fields: [companyId], references: [id]) metaId String? name String language String @default("pt_BR") category String status String @default("PENDING") body String? header String? footer String? updatedAtMeta DateTime? createdAt DateTime @default(now()) @@unique([companyId, name, language]) }
model Campaign { id String @id @default(cuid()) companyId String company Company @relation(fields: [companyId], references: [id]) name String templateId String? templateName String language String @default("pt_BR") category String status String @default("DRAFT") scheduledAt DateTime? createdAt DateTime @default(now()) recipients CampaignRecipient[] messages Message[] }
model CampaignRecipient { id String @id @default(cuid()) campaignId String campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade) contactId String contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade) status String @default("QUEUED") error String? companyId String createdAt DateTime @default(now()) @@unique([campaignId, contactId]) }
model Message { id String @id @default(cuid()) companyId String company Company @relation(fields: [companyId], references: [id]) contactId String? contact Contact? @relation(fields: [contactId], references: [id]) campaignId String? campaign Campaign? @relation(fields: [campaignId], references: [id]) wamId String? @unique direction String type String templateName String? content String? status String @default("QUEUED") error String? createdAt DateTime @default(now()) }
model WebhookEvent { id String @id @default(cuid()) companyId String? type String payload Json processed Boolean @default(false) createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) companyId String? userId String? user User? @relation(fields: [userId], references: [id]) action String entity String entityId String? details Json? ip String? createdAt DateTime @default(now()) }
